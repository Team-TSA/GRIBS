{
  "schema_version": "0.4.4-alpha",
  "notes": [
    "Baseline verification case for the GRIBS v0.5.0-alpha code review.",
    "Binder is represented by C7H8 (toluene) because the packaged CEA database has no HTPB/C4H6 entry; this is a surrogate, not a real propellant.",
    "Numbers are chosen to give a representative composite-propellant motor (p ~ 4-5 MPa, burn time ~ 2-3 s)."
  ],
  "propellant": {
    "description": "AP/Al/binder surrogate 70/16/14 wt%",
    "packing_fraction": 0.97,
    "reactants": [
      {
        "name": "NH4CLO4(I)",
        "wt_percent": 70.0,
        "temperature_K": 294.0,
        "density_kg_m3": 1950.0
      },
      {
        "name": "AL(cr)",
        "wt_percent": 16.0,
        "temperature_K": 294.0,
        "density_kg_m3": 2700.0
      },
      {
        "name": "C7H8",
        "wt_percent": 14.0,
        "temperature_K": 294.0,
        "density_kg_m3": 866.0
      }
    ],
    "burn_law": {
      "coefficient_m_s": 0.005,
      "pressure_exponent": 0.35,
      "reference_pressure_Pa": 1000000.0,
      "temperature_sensitivity_1_K": 0.002,
      "grain_temperature_K": 294.0,
      "reference_temperature_K": 294.0,
      "erosive_burning": {
        "enabled": false,
        "alpha": 0.0,
        "beta": 53.0
      }
    }
  },
  "grain": {
    "initial_bore_radius_m": 0.008,
    "outer_radius_m": 0.03,
    "initial_length_m": 0.15,
    "initial_free_volume_m3": 3e-05,
    "burning_end_faces": 1.0
  },
  "nozzle": {
    "initial_throat_radius_m": 0.004,
    "expansion_ratio": 1.0,
    "discharge_coefficient": 0.98,
    "thrust_efficiency": 0.98,
    "flow_separation": {
      "enabled": true,
      "pressure_ratio": 0.4
    },
    "throat_erosion": {
      "enabled": false,
      "rate_m_s_at_reference_pressure": 0.0,
      "pressure_exponent": 1.0
    }
  },
  "environment": {
    "ambient_pressure_Pa": 101325.0,
    "initial_chamber_pressure_Pa": 500000.0
  },
  "igniter": {
    "mass_flow_kg_s": 0.02,
    "duration_s": 0.1
  },
  "thermochemistry": {
    "backend": "cea_python",
    "temperature_efficiency": 1.0,
    "outside_range_policy": "clamp",
    "pressure_range": {
      "minimum_Pa": 100000.0,
      "maximum_Pa": 8000000.0
    },
    "pressure_points": 81,
    "cea_python": {
      "ions": false,
      "transport": false,
      "trace": 1e-10,
      "products_from_reactants": true,
      "product_species": [],
      "omit_species": [],
      "insert_species": [],
      "molecular_weight": "gas_phase_M",
      "smooth_truncation": false,
      "truncation_width": -1.0,
      "rocket_diagnostics": true,
      "cache_enabled": true,
      "rebuild_cache": false,
      "cache_directory": ""
    }
  },
  "two_phase_model": {
    "mode": "homogeneous_equilibrium",
    "condensed_volume": "neglected",
    "nozzle_entrainment": "complete"
  },
  "solver": {
    "method": "LSODA",
    "relative_tolerance": 1e-09,
    "pressure_absolute_tolerance_Pa": 0.001,
    "burn_depth_absolute_tolerance_m": 1e-13,
    "burning_time_limit_s": 600.0,
    "maximum_burning_step_s": 0.02,
    "unchoked_policy": "switch",
    "blowdown": {
      "enabled": true,
      "time_limit_s": 5.0,
      "maximum_step_s": 0.0005
    }
  },
  "output": {
    "directory": "results",
    "figure_filename": "conv_nozzle_result.png",
    "history_filename": "conv_nozzle_history.csv",
    "summary_text_filename": "conv_nozzle_summary.txt",
    "summary_json_filename": "conv_nozzle_summary.json"
  }
}